---
export interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}
const { title, description = "A curated edit of Scandinavian heel design.", activeNav = "" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>

  <!-- HEADER -->
  <header class="site-header" id="site-header">
    <div class="header-inner container">
      <nav class="header-nav header-nav--left">
        <a href="/blog" class={`nav-link${activeNav === 'blog' ? ' nav-link--active' : ''}`}>The Edit</a>
        <a href="/collections" class={`nav-link${activeNav === 'collections' ? ' nav-link--active' : ''}`}>Brands</a>
      </nav>

      <a href="/" class="site-logo" aria-label="Block & Point Home">
        <svg class="logo-svg" viewBox="0 0 164 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <text x="0" y="28" font-family="'Cormorant Garamond', serif" font-size="32" font-weight="400" fill="currentColor" letter-spacing="-1">B</text>
          <text x="20" y="28" font-family="'Cormorant Garamond', serif" font-size="18" font-weight="300" fill="currentColor" opacity="0.5">&amp;</text>
          <text x="34" y="28" font-family="'Cormorant Garamond', serif" font-size="32" font-weight="400" fill="currentColor" letter-spacing="-1">P</text>
          <line x1="60" y1="30" x2="164" y2="30" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
          <text x="60" y="24" font-family="'DM Sans', sans-serif" font-size="7" font-weight="300" fill="currentColor" opacity="0.6" letter-spacing="2.5">BLOCK &amp; POINT</text>
        </svg>
      </a>

      <nav class="header-nav header-nav--right">
        <a href="/#newsletter" class="nav-link">Newsletter</a>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
          <svg viewBox="0 0 20 20" fill="none" width="16" height="16">
            <circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.2"/>
            <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.22 4.22l1.42 1.42M14.36 14.36l1.42 1.42M4.22 15.78l1.42-1.42M14.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" class="sun-rays"/>
            <path d="M14 10a4 4 0 11-8 0 6 6 0 008 0z" fill="currentColor" class="moon-shape" style="display:none"/>
          </svg>
        </button>
        <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false">
          <span></span><span></span>
        </button>
      </nav>
    </div>

    <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
      <a href="/blog" class="mobile-nav-link">The Edit</a>
      <a href="/collections" class="mobile-nav-link">Brands</a>
      <a href="/#newsletter" class="mobile-nav-link">Newsletter</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <a href="/" class="footer-logo" aria-label="Block & Point">
            <span class="footer-logo-text">B&amp;P</span>
          </a>
          <p class="footer-tagline">A curated edit of<br />Scandinavian heel design.</p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <div class="footer-nav-col">
            <span class="footer-nav-label">Explore</span>
            <a href="/collections" class="footer-link">Brand Directory</a>
            <a href="/blog" class="footer-link">The Edit</a>
            <a href="/#newsletter" class="footer-link">Newsletter</a>
          </div>
          <div class="footer-nav-col">
            <span class="footer-nav-label">Styles</span>
            <a href="/blog" class="footer-link">Block Heels</a>
            <a href="/blog" class="footer-link">Pointed Heels</a>
            <a href="/blog" class="footer-link">Kitten Heels</a>
          </div>
        </nav>
      </div>
      <div class="footer-bottom">
        <p class="footer-legal">&copy; 2025 Block &amp; Point. Affiliate links used — we earn a commission on purchases at no extra cost to you.</p>
        <div class="footer-legal-links">
          <a href="#" class="footer-link footer-link--small">Privacy</a>
          <a href="#" class="footer-link footer-link--small">Affiliate Disclosure</a>
        </div>
      </div>
    </div>
  </footer>

  <script src="/script.js" is:inline></script>
</body>
</html>
