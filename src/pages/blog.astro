---
import Base from '../layouts/Base.astro';
---
<Base title="The Edit — Block & Point" description="Honest writing about Scandinavian heels. Brand comparisons, buying guides, and Nordic heel culture — no fluff, no filler." activeNav="blog">
<!-- ═══════════════════════════════════════════ PAGE HERO -->
    <section class="page-hero page-hero--editorial">
      <div class="container">
        <div class="page-hero-content reveal">
          <span class="section-label">The Edit</span>
          <h1 class="page-hero-title">Words About<br /><em>Heels Worth Having.</em></h1>
          <p class="page-hero-subtitle">Brand comparisons, buying guides, and honest opinions on Scandinavian footwear — without the SEO filler.</p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ CATEGORY FILTER -->
    <div class="filter-bar" id="filter-bar">
      <div class="container">
        <div class="filter-inner">
          <button class="filter-btn filter-btn--active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="comparison">Comparisons</button>
          <button class="filter-btn" data-filter="guide">Buying Guides</button>
          <button class="filter-btn" data-filter="brand">Brand Stories</button>
          <button class="filter-btn" data-filter="style">Style</button>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════ FEATURED POST -->
    <section class="blog-featured section-pad">
      <div class="container">
        <article class="blog-feature-card reveal" data-category="comparison">
          <a href="/atp-atelier-vs-flattered" class="blog-feature-image-link">
            <img src="/editorial-1.png" alt="ATP Atelier vs Flattered comparison" class="blog-feature-image" loading="eager" />
          </a>
          <div class="blog-feature-body">
            <div class="blog-feature-meta">
              <span class="post-category post-category--comparison">Brand Comparison</span>
              <span class="post-read-time">8 min read</span>
            </div>
            <h2 class="blog-feature-title">
              <a href="/atp-atelier-vs-flattered">ATP Atelier vs. Flattered: Which Swedish Heel Brand Is Actually Worth It?</a>
            </h2>
            <p class="blog-feature-excerpt">Two Stockholm studios. Two answers to the question of what makes a heel worth buying. We compared the leather quality, construction standards, sizing accuracy, price-per-wear, and longevity of both brands across three heel types. One recommendation came out clearly — but it depends on who you are.</p>
            <a href="/atp-atelier-vs-flattered" class="btn btn--primary">Read the comparison</a>
          </div>
        </article>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ POST GRID -->
    <section class="blog-grid-section section-pad">
      <div class="container">
        <div class="blog-grid" id="blog-grid">

          <article class="blog-card reveal" data-delay="0" data-category="guide">
            <a href="/blog" class="blog-card-image-link">
              <img src="/block-hero.png" alt="Block heel buying guide" class="blog-card-image" loading="lazy" />
            </a>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="post-category post-category--guide">Buying Guide</span>
                <span class="post-read-time">6 min</span>
              </div>
              <h3 class="blog-card-title">
                <a href="/blog">The Block Heel Buyer's Guide: Nordic Shapes Worth Owning in 2024</a>
              </h3>
              <p class="blog-card-excerpt">From Flattered's square toe mule to Vagabond's refined utility boot — a complete guide to finding your block heel.</p>
            </div>
          </article>

          <article class="blog-card reveal" data-delay="100" data-category="brand">
            <a href="/blog" class="blog-card-image-link">
              <img src="/craft-detail.png" alt="Scandinavian leather craftsmanship" class="blog-card-image" loading="lazy" />
            </a>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="post-category post-category--brand">Brand Story</span>
                <span class="post-read-time">5 min</span>
              </div>
              <h3 class="blog-card-title">
                <a href="/blog">Why Scandinavian Shoes Last Longer (And What That Tells You About the Industry)</a>
              </h3>
              <p class="blog-card-excerpt">The Nordic obsession with material honesty, resoleable construction, and what it means for your wardrobe over time.</p>
            </div>
          </article>

          <article class="blog-card reveal" data-delay="200" data-category="style">
            <a href="/blog" class="blog-card-image-link">
              <img src="/collection-flatlay.png" alt="Heel height guide" class="blog-card-image" loading="lazy" />
            </a>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="post-category post-category--style">Style Guide</span>
                <span class="post-read-time">4 min</span>
              </div>
              <h3 class="blog-card-title">
                <a href="/blog">Kitten to Stiletto: Finding Your Nordic Heel Height</a>
              </h3>
              <p class="blog-card-excerpt">A practical guide to matching heel height to lifestyle — the Scandinavian way. With brand recommendations at each height.</p>
            </div>
          </article>

          <article class="blog-card reveal" data-delay="0" data-category="comparison">
            <a href="/blog" class="blog-card-image-link">
              <img src="/hero.png" alt="Roccamore vs Flattered comfort comparison" class="blog-card-image" loading="lazy" />
            </a>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="post-category post-category--comparison">Comparison</span>
                <span class="post-read-time">7 min</span>
              </div>
              <h3 class="blog-card-title">
                <a href="/blog">Roccamore vs. Flattered: The Comfort Heel Comparison</a>
              </h3>
              <p class="blog-card-excerpt">Denmark's biomechanical approach versus Sweden's anatomical design. Both promise all-day comfort — only one fully delivers.</p>
            </div>
          </article>

          <article class="blog-card reveal" data-delay="100" data-category="guide">
            <a href="/blog" class="blog-card-image-link">
              <img src="/editorial-1.png" alt="First Scandi heel purchase guide" class="blog-card-image" loading="lazy" />
            </a>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="post-category post-category--guide">Buying Guide</span>
                <span class="post-read-time">5 min</span>
              </div>
              <h3 class="blog-card-title">
                <a href="/blog">Buying Your First Scandinavian Heel: A Starter Framework</a>
              </h3>
              <p class="blog-card-excerpt">Budget, occasion, comfort needs — a decision tree for choosing between Vagabond, Flattered, and ATP Atelier as your entry point.</p>
            </div>
          </article>

          <article class="blog-card reveal" data-delay="200" data-category="brand">
            <a href="/blog" class="blog-card-image-link">
              <img src="/craft-detail.png" alt="Aeyde Berlin brand story" class="blog-card-image" loading="lazy" />
            </a>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="post-category post-category--brand">Brand Story</span>
                <span class="post-read-time">4 min</span>
              </div>
              <h3 class="blog-card-title">
                <a href="/blog">Why Aeyde Belongs in the Nordic Heel Conversation</a>
              </h3>
              <p class="blog-card-excerpt">Berlin-based, Nordic in sensibility. How Aeyde's European precision ended up speaking the same language as Stockholm's finest.</p>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ NEWSLETTER -->
    <section class="newsletter-section section-pad" id="newsletter">
      <div class="container">
        <div class="newsletter-inner reveal">
          <div class="newsletter-header">
            <span class="section-label">Weekly Newsletter</span>
            <h2 class="newsletter-title">This Week in Heels</h2>
            <p class="newsletter-subtitle">Five trending pairs, sourced from Scandi streets and global catwalks — every Monday.</p>
          </div>
          <form class="newsletter-form" id="newsletter-form" novalidate>
            <div class="newsletter-input-group">
              <input type="email" class="newsletter-input" id="newsletter-email" name="email" placeholder="Your email address" required autocomplete="email" />
              <button type="submit" class="btn btn--primary newsletter-submit">Subscribe</button>
            </div>
            <p class="newsletter-disclaimer">Weekly. Unsubscribe anytime.</p>
          </form>
        </div>
      </div>
    </section>
</Base>
