---
import Base from '../layouts/Base.astro';
---
<Base title="Brand Directory — Block & Point" description="Seven Scandinavian heel brands worth knowing. ATP Atelier, Flattered, Vagabond, Roccamore, Anonymous Copenhagen, Aeyde, and Sania d'Mina." activeNav="collections">
<!-- ═══════════════════════════════════════════ PAGE HERO -->
    <section class="page-hero">
      <div class="container">
        <div class="page-hero-content reveal">
          <span class="section-label">Brand Directory</span>
          <h1 class="page-hero-title">Seven Brands.<br /><em>One Nordic Standard.</em></h1>
          <p class="page-hero-subtitle">These are the Scandinavian and Nordic-adjacent heel makers we return to — for the materials, the last, and the lack of compromise.</p>
        </div>
      </div>
      <div class="page-hero-image-strip">
        <img src="/collection-flatlay.png" alt="Collection of Scandinavian heels" class="page-hero-strip-image" loading="eager" />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ FILTER BAR -->
    <div class="filter-bar sticky-filter" id="filter-bar">
      <div class="container">
        <div class="filter-inner">
          <button class="filter-btn filter-btn--active" data-filter="all">All Brands</button>
          <button class="filter-btn" data-filter="sweden">Sweden</button>
          <button class="filter-btn" data-filter="denmark">Denmark</button>
          <button class="filter-btn" data-filter="germany">Germany</button>
          <span class="filter-count" id="filter-count">7 brands</span>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════ BRAND LISTINGS -->
    <section class="brand-listings section-pad">
      <div class="container">

        <!-- ── ATP ATELIER ── -->
        <article class="brand-profile reveal" id="atp-atelier" data-country="sweden">
          <div class="brand-profile-image-col">
            <div class="brand-profile-image-wrap">
              <img src="/editorial-1.png" alt="ATP Atelier leather heel editorial" class="brand-profile-image" loading="lazy" />
            </div>
            <div class="brand-profile-badge">
              <span class="brand-tier">Tier 1 — Anchor Brand</span>
            </div>
          </div>
          <div class="brand-profile-content">
            <div class="brand-profile-header">
              <div class="brand-profile-meta">
                <span class="brand-country">Sweden · Since 2013</span>
                <span class="brand-range">$250 – $450</span>
              </div>
              <h2 class="brand-profile-name">ATP Atelier</h2>
              <p class="brand-profile-tagline"><em>The leather obsessives.</em></p>
            </div>
            <p class="brand-profile-desc">Founded in Skåne by Alexander Torlén and Per Franssén, ATP Atelier built its reputation on a single conviction: that vegetable-tanned leather, properly sourced and honestly constructed, is the only material worthy of a well-designed shoe. Their heels — mostly block and stacked — carry the weight of that philosophy in every stitch.</p>
            <p class="brand-profile-desc">The result is footwear that improves with age. Unlike synthetic-sole shoes that degrade, ATP Atelier pairs are resoleable. They have collaborated with Vogue Scandinavia and remain a fixture of Stockholm Fashion Week — aspirational without being inaccessible.</p>
            <div class="brand-profile-specs">
              <div class="spec-item"><span class="spec-label">Best for</span><span class="spec-value">Block mules, leather sandals, stacked heels</span></div>
              <div class="spec-item"><span class="spec-label">Materials</span><span class="spec-value">Vegetable-tanned leather, recycled linings</span></div>
              <div class="spec-item"><span class="spec-label">Sizing</span><span class="spec-value">EU 35–42, half sizes available</span></div>
              <div class="spec-item"><span class="spec-label">Ships from</span><span class="spec-value">Sweden, worldwide</span></div>
            </div>
            <div class="brand-profile-actions">
              <a href="https://www.farfetch.com/shopping/women/atp-atelier/items.aspx?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=brand-directory&utm_content=seg-luxury&utm_term=atp-atelier" class="btn btn--primary" target="_blank" rel="noopener nofollow">Shop ATP Atelier at Farfetch</a>
              <a href="/atp-atelier-vs-flattered" class="btn btn--ghost">Read comparison →</a>
            </div>
          </div>
        </article>

        <div class="brand-divider"></div>

        <!-- ── FLATTERED ── -->
        <article class="brand-profile brand-profile--reverse reveal" id="flattered" data-country="sweden">
          <div class="brand-profile-image-col">
            <div class="brand-profile-image-wrap">
              <img src="/block-hero.png" alt="Flattered white block heel mule" class="brand-profile-image" loading="lazy" />
            </div>
            <div class="brand-profile-badge">
              <span class="brand-tier">Tier 1 — Anchor Brand</span>
            </div>
          </div>
          <div class="brand-profile-content">
            <div class="brand-profile-header">
              <div class="brand-profile-meta">
                <span class="brand-country">Sweden · Since 2009</span>
                <span class="brand-range">$180 – $350</span>
              </div>
              <h2 class="brand-profile-name">Flattered</h2>
              <p class="brand-profile-tagline"><em>The wearability experts.</em></p>
            </div>
            <p class="brand-profile-desc">Flattered was born from a simple question: why should comfort and beauty be in conflict? The Stockholm-based label focuses on anatomically supportive shapes — rounder toes, lower stacked heels, supple leather — that allow you to wear them all day without apology.</p>
            <p class="brand-profile-desc">Their palette runs deliberately neutral: natural leathers, whites, blacks, and the occasional considered colour. Regulars of Scandinavia Standard's "best of" lists, Flattered has quietly become the working wardrobe heel — the one you wear to the gallery opening and keep on through dinner.</p>
            <div class="brand-profile-specs">
              <div class="spec-item"><span class="spec-label">Best for</span><span class="spec-value">Ankle boots, mules, everyday block heels</span></div>
              <div class="spec-item"><span class="spec-label">Materials</span><span class="spec-value">Full-grain leather, nubuck, suede</span></div>
              <div class="spec-item"><span class="spec-label">Sizing</span><span class="spec-value">EU 35–42</span></div>
              <div class="spec-item"><span class="spec-label">Ships from</span><span class="spec-value">Sweden, worldwide</span></div>
            </div>
            <div class="brand-profile-actions">
              <a href="https://www.nordstrom.com/brands/flattered--12174?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=brand-directory&utm_content=seg-classic&utm_term=flattered" class="btn btn--primary" target="_blank" rel="noopener nofollow">Shop Flattered at Nordstrom</a>
              <a href="/atp-atelier-vs-flattered" class="btn btn--ghost">Read comparison →</a>
            </div>
          </div>
        </article>

        <div class="brand-divider"></div>

        <!-- ── VAGABOND ── -->
        <article class="brand-profile reveal" id="vagabond" data-country="sweden">
          <div class="brand-profile-image-col">
            <div class="brand-profile-image-wrap">
              <img src="/craft-detail.png" alt="Vagabond heel detail craftsmanship" class="brand-profile-image" loading="lazy" />
            </div>
            <div class="brand-profile-badge">
              <span class="brand-tier">Tier 1 — Volume Brand</span>
            </div>
          </div>
          <div class="brand-profile-content">
            <div class="brand-profile-header">
              <div class="brand-profile-meta">
                <span class="brand-country">Sweden · Since 1973</span>
                <span class="brand-range">$100 – $200</span>
              </div>
              <h2 class="brand-profile-name">Vagabond Shoemakers</h2>
              <p class="brand-profile-tagline"><em>The democratic option.</em></p>
            </div>
            <p class="brand-profile-desc">Half a century of Swedish shoe-making gives Vagabond a confidence that newer brands have to earn. At the accessible end of the Scandinavian heel spectrum, Vagabond offers the same clean lines and considered design language at a price that doesn't require financial planning.</p>
            <p class="brand-profile-desc">Their heeled offerings span from utilitarian block-heel ankle boots to genuinely refined pointed-toe pumps. The construction has improved markedly in recent years. An ideal entry point into Scandinavian heel design — and consistently one of the best-selling heel brands on ASOS and Nordstrom.</p>
            <div class="brand-profile-specs">
              <div class="spec-item"><span class="spec-label">Best for</span><span class="spec-value">Entry point, ankle boots, everyday pumps</span></div>
              <div class="spec-item"><span class="spec-label">Materials</span><span class="spec-value">Leather, microfibre, synthetic blends</span></div>
              <div class="spec-item"><span class="spec-label">Sizing</span><span class="spec-value">EU 35–43, wide fit available</span></div>
              <div class="spec-item"><span class="spec-label">Ships from</span><span class="spec-value">Global distribution</span></div>
            </div>
            <div class="brand-profile-actions">
              <a href="https://www.asos.com/search/?q=vagabond&utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=brand-directory&utm_content=seg-comfort&utm_term=vagabond" class="btn btn--primary" target="_blank" rel="noopener nofollow">Shop Vagabond at ASOS</a>
              <a href="https://www.nordstrom.com/brands/vagabond-shoemakers--12337?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=brand-directory&utm_content=seg-comfort&utm_term=vagabond" class="btn btn--ghost" target="_blank" rel="noopener nofollow">Also at Nordstrom</a>
            </div>
          </div>
        </article>

        <div class="brand-divider"></div>

        <!-- ── SANIA D'MINA ── -->
        <article class="brand-profile brand-profile--reverse reveal" id="sania-dmina" data-country="sweden">
          <div class="brand-profile-image-col">
            <div class="brand-profile-image-wrap">
              <img src="/editorial-1.png" alt="Sania d'Mina luxury heel editorial" class="brand-profile-image" loading="lazy" />
            </div>
            <div class="brand-profile-badge">
              <span class="brand-tier">Tier 1 — Luxury Anchor</span>
            </div>
          </div>
          <div class="brand-profile-content">
            <div class="brand-profile-header">
              <div class="brand-profile-meta">
                <span class="brand-country">Sweden · Independent</span>
                <span class="brand-range">$300 – $600</span>
              </div>
              <h2 class="brand-profile-name">Sania d'Mina</h2>
              <p class="brand-profile-tagline"><em>The Swedish luxury case.</em></p>
            </div>
            <p class="brand-profile-desc">Sania d'Mina represents the quieter end of Swedish luxury — the label you discover through someone with impeccable taste, not through a campaign. Founder Sania Hedengren brings a fashion-editorial sensibility to every design: considered proportions, exceptional last shapes, and materials that earn their price.</p>
            <p class="brand-profile-desc">If ATP Atelier is the craft argument and Flattered is the practical argument, Sania d'Mina is the beauty argument. Pointed kitten heels, refined stilettos, and slingbacks that read as sculpture from across a room.</p>
            <div class="brand-profile-specs">
              <div class="spec-item"><span class="spec-label">Best for</span><span class="spec-value">Luxury gifting, statement pieces, occasions</span></div>
              <div class="spec-item"><span class="spec-label">Materials</span><span class="spec-value">Premium leather, exotics, fine suede</span></div>
              <div class="spec-item"><span class="spec-label">Sizing</span><span class="spec-value">EU 35–42</span></div>
              <div class="spec-item"><span class="spec-label">Ships from</span><span class="spec-value">Sweden, select global</span></div>
            </div>
            <div class="brand-profile-actions">
              <a href="https://www.farfetch.com/shopping/women/sania-dmina/items.aspx?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=brand-directory&utm_content=seg-luxury&utm_term=sania-dmina" class="btn btn--primary" target="_blank" rel="noopener nofollow">Shop Sania d'Mina at Farfetch</a>
            </div>
          </div>
        </article>

        <div class="brand-divider"></div>

        <!-- ── ROCCAMORE ── -->
        <article class="brand-profile reveal" id="roccamore" data-country="denmark">
          <div class="brand-profile-image-col">
            <div class="brand-profile-image-wrap">
              <img src="/collection-flatlay.png" alt="Roccamore ergonomic heel collection" class="brand-profile-image" loading="lazy" />
            </div>
            <div class="brand-profile-badge">
              <span class="brand-tier">Tier 1 — Anchor Brand</span>
            </div>
          </div>
          <div class="brand-profile-content">
            <div class="brand-profile-header">
              <div class="brand-profile-meta">
                <span class="brand-country">Denmark · Since 2015</span>
                <span class="brand-range">$200 – $350</span>
              </div>
              <h2 class="brand-profile-name">Roccamore</h2>
              <p class="brand-profile-tagline"><em>The biomechanics brand.</em></p>
            </div>
            <p class="brand-profile-desc">Roccamore began with a podiatrist and a shoe designer sitting down to solve the same problem from opposite ends. The Copenhagen label's heels are engineered with anatomical footbeds, distributed pressure technology, and arch support — not as an afterthought, but as the entire design brief.</p>
            <p class="brand-profile-desc">The result looks like any other beautifully designed Danish heel. It walks like something engineered to keep you comfortable for twelve hours. A remarkable trick, consistently delivered.</p>
            <div class="brand-profile-specs">
              <div class="spec-item"><span class="spec-label">Best for</span><span class="spec-value">All-day wear, standing events, weddings</span></div>
              <div class="spec-item"><span class="spec-label">Technology</span><span class="spec-value">Memory foam insole, arch support, wide toe box</span></div>
              <div class="spec-item"><span class="spec-label">Sizing</span><span class="spec-value">EU 35–43, half sizes</span></div>
              <div class="spec-item"><span class="spec-label">Ships from</span><span class="spec-value">Denmark, worldwide</span></div>
            </div>
            <div class="brand-profile-actions">
              <a href="https://www.roccamore.com?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=brand-directory&utm_content=seg-comfort&utm_term=roccamore" class="btn btn--primary" target="_blank" rel="noopener nofollow">Shop Roccamore Direct</a>
            </div>
          </div>
        </article>

        <div class="brand-divider"></div>

        <!-- ── ANONYMOUS COPENHAGEN ── -->
        <article class="brand-profile brand-profile--reverse reveal" id="anonymous-copenhagen" data-country="denmark">
          <div class="brand-profile-image-col">
            <div class="brand-profile-image-wrap">
              <img src="/block-hero.png" alt="Anonymous Copenhagen heel design" class="brand-profile-image" loading="lazy" />
            </div>
            <div class="brand-profile-badge">
              <span class="brand-tier">Tier 1 — Anchor Brand</span>
            </div>
          </div>
          <div class="brand-profile-content">
            <div class="brand-profile-header">
              <div class="brand-profile-meta">
                <span class="brand-country">Denmark · Since 2016</span>
                <span class="brand-range">$200 – $400</span>
              </div>
              <h2 class="brand-profile-name">Anonymous Copenhagen</h2>
              <p class="brand-profile-tagline"><em>The editorial minimalists.</em></p>
            </div>
            <p class="brand-profile-desc">Anonymous Copenhagen earned its name by doing the opposite of what the name implies — every piece is immediately recognisable. The Copenhagen label's heels have a particular architectural quality: volume where you expect restraint, restraint where you expect decoration.</p>
            <p class="brand-profile-desc">Their heeled boots and shoes are a fixture of Copenhagen Fashion Week street style, and that visibility has translated into genuine demand. Stocked at Nordstrom and increasingly at premium independents globally.</p>
            <div class="brand-profile-specs">
              <div class="spec-item"><span class="spec-label">Best for</span><span class="spec-value">Statement boots, editorial styling, fashion week</span></div>
              <div class="spec-item"><span class="spec-label">Materials</span><span class="spec-value">Fine leather, suede, structured materials</span></div>
              <div class="spec-item"><span class="spec-label">Sizing</span><span class="spec-value">EU 36–41</span></div>
              <div class="spec-item"><span class="spec-label">Ships from</span><span class="spec-value">Denmark, worldwide</span></div>
            </div>
            <div class="brand-profile-actions">
              <a href="https://www.nordstrom.com/brands/anonymous-copenhagen--21432?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=brand-directory&utm_content=seg-edgy&utm_term=anonymous-cph" class="btn btn--primary" target="_blank" rel="noopener nofollow">Shop at Nordstrom</a>
            </div>
          </div>
        </article>

        <div class="brand-divider"></div>

        <!-- ── AEYDE ── -->
        <article class="brand-profile reveal" id="aeyde" data-country="germany">
          <div class="brand-profile-image-col">
            <div class="brand-profile-image-wrap">
              <img src="/craft-detail.png" alt="Aeyde precision heel craftsmanship" class="brand-profile-image" loading="lazy" />
            </div>
            <div class="brand-profile-badge">
              <span class="brand-tier">Tier 1 — Nordic-Adjacent</span>
            </div>
          </div>
          <div class="brand-profile-content">
            <div class="brand-profile-header">
              <div class="brand-profile-meta">
                <span class="brand-country">Germany (Berlin) · Since 2016</span>
                <span class="brand-range">$250 – $450</span>
              </div>
              <h2 class="brand-profile-name">Aeyde</h2>
              <p class="brand-profile-tagline"><em>The Berlin precision argument.</em></p>
            </div>
            <p class="brand-profile-desc">Technically German, spiritually Scandinavian — Aeyde's Berlin-based design language shares the same obsessions as its Nordic peers: clean lines, exceptional leather, and shapes that read as permanent rather than seasonal. Founded by Max Kempe and Kerstin von Werz, the brand is made in Europe using traditional craft techniques.</p>
            <p class="brand-profile-desc">Where Aeyde distinguishes itself is in the pointed heel category — their pointed-toe slingbacks, kitten heels, and stilettos have a particular refinement that earns the luxury positioning. Stocked at NET-A-PORTER and Farfetch; beloved by buyers who want the precision of French luxury at a slightly more approachable price.</p>
            <div class="brand-profile-specs">
              <div class="spec-item"><span class="spec-label">Best for</span><span class="spec-value">Pointed heels, slingbacks, precision styling</span></div>
              <div class="spec-item"><span class="spec-label">Materials</span><span class="spec-value">Italian calf leather, suede, nappa</span></div>
              <div class="spec-item"><span class="spec-label">Sizing</span><span class="spec-value">EU 35–41</span></div>
              <div class="spec-item"><span class="spec-label">Ships from</span><span class="spec-value">Europe, worldwide</span></div>
            </div>
            <div class="brand-profile-actions">
              <a href="https://www.farfetch.com/shopping/women/aeyde/items.aspx?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=brand-directory&utm_content=seg-luxury&utm_term=aeyde" class="btn btn--primary" target="_blank" rel="noopener nofollow">Shop Aeyde at Farfetch</a>
              <a href="https://www.net-a-porter.com/en-gb/shop/designer/aeyde?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=brand-directory&utm_content=seg-luxury&utm_term=aeyde" class="btn btn--ghost" target="_blank" rel="noopener nofollow">Also at NET-A-PORTER</a>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════ RETAILER STRIP -->
    <section class="retailer-strip section-pad">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Also Worth Knowing</span>
          <h2 class="section-title">Scandi-Adjacent Retailers</h2>
          <p class="section-subtitle">COS, ARKET, and & Other Stories carry the same Nordic sensibility at accessible prices — perfect first heels, gifting, and wardrobe building.</p>
        </div>
        <div class="retailer-grid">
          <div class="retailer-card reveal" data-delay="0">
            <h3 class="retailer-name">COS</h3>
            <p class="retailer-desc">H&M Group's elevated label. Architectural shapes, muted palettes, and heel designs that are surprisingly considered for the price. Their kitten heels and block mules consistently over-deliver.</p>
            <a href="https://www.cos.com/en_gbp/women/shoes/heels.html?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=retailer-strip&utm_content=seg-classic&utm_term=cos" class="btn btn--text" target="_blank" rel="noopener nofollow">Shop COS heels →</a>
          </div>
          <div class="retailer-card reveal" data-delay="100">
            <h3 class="retailer-name">ARKET</h3>
            <p class="retailer-desc">H&M Group's most considered concept. ARKET heels are designed with longevity in mind — fewer styles, better materials, a slower approach to footwear that rewards patience.</p>
            <a href="https://www.arket.com/en_gbp/women/shoes.html?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=retailer-strip&utm_content=seg-classic&utm_term=arket" class="btn btn--text" target="_blank" rel="noopener nofollow">Shop ARKET heels →</a>
          </div>
          <div class="retailer-card reveal" data-delay="200">
            <h3 class="retailer-name">&amp; Other Stories</h3>
            <p class="retailer-desc">The fashion-forward H&M Group label. Trend-aware but anchored in Scandinavian restraint. Their seasonal heel drops are worth watching — quality has improved consistently since 2020.</p>
            <a href="https://www.stories.com/en_gbp/shoes/heels.html?utm_source=blockandpoint&utm_medium=affiliate&utm_campaign=retailer-strip&utm_content=seg-trendy&utm_term=other-stories" class="btn btn--text" target="_blank" rel="noopener nofollow">Shop &amp; Other Stories →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ NEWSLETTER -->
    <section class="newsletter-section section-pad" id="newsletter">
      <div class="container">
        <div class="newsletter-inner reveal">
          <div class="newsletter-header">
            <span class="section-label">Weekly Newsletter</span>
            <h2 class="newsletter-title">This Week in Heels</h2>
            <p class="newsletter-subtitle">Five trending pairs every Monday. New drops, brand news, and Scandi heel culture — direct to your inbox.</p>
          </div>
          <form class="newsletter-form" id="newsletter-form" novalidate>
            <div class="newsletter-input-group">
              <input type="email" class="newsletter-input" id="newsletter-email" name="email" placeholder="Your email address" required autocomplete="email" />
              <button type="submit" class="btn btn--primary newsletter-submit">Subscribe</button>
            </div>
            <p class="newsletter-disclaimer">Weekly. Unsubscribe anytime.</p>
          </form>
        </div>
      </div>
    </section>
</Base>
