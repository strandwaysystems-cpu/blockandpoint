---
// Guides — silo index for informational pages.
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site_architecture.json';

const pages = await Astro.glob('./*.md');
const items = pages
  .map((p) => ({ url: p.url, ...p.frontmatter }))
  .sort((a, b) => (b.updated ?? '').localeCompare(a.updated ?? ''));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Block & Point guides',
    itemListElement: items.map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: new URL(it.url, site.base_url).href,
    })),
  },
];
---
<BaseLayout
  title="Guides — Block & Point"
  description="Sizing, heel height and leather care for Scandinavian footwear. The practical questions that decide whether a shoe works, answered properly."
  activeNav="guides"
  pageType="informational"
  jsonLd={jsonLd}
>
  <section class="page-hero page-hero--editorial">
    <div class="container">
      <div class="page-hero-content reveal">
        <span class="section-label">Guides</span>
        <h1 class="page-hero-title">The Practical<br /><em>Questions.</em></h1>
        <p class="page-hero-subtitle">
          Sizing, heel height and care. The things that decide whether a shoe works, rather than
          whether it looks good in a photograph.
        </p>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container">
      <div class="silo-grid">
        {items.map((it) => (
          <article class="silo-card reveal">
            <span class="silo-card__type">Guide</span>
            <h2 class="silo-card__title"><a href={it.url}>{it.title}</a></h2>
            <p class="silo-card__desc">{it.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
