# Apache / LiteSpeed (Hostinger) configuration.
#
# Astro is configured with build.format: 'file', which emits /edit/foo.html and
# the silo index as /edit.html. Cloudflare Pages serves those extensionless for
# free; Apache does not, so this file does three jobs:
#
#   1. mirrors the 301s in public/_redirects, so behaviour is identical on
#      either host;
#   2. serves /path from /path.html without exposing the extension;
#   3. keeps exactly one canonical URL form — extensionless, no trailing slash.
#
# Note the ordering below is deliberate. A silo like /edit exists BOTH as a
# real directory (dist/edit/, holding the spoke pages) and as a sibling file
# (dist/edit.html, the index). A request for "/edit/" therefore matches a real
# directory that contains no index.html, so the generic "strip trailing slash
# unless it is a directory" rule would skip it and Apache would fall through to
# a 403 or a directory listing. The sibling-file rule runs first to catch that.

Options -Indexes

# Both matter for the silo layout described above. Without DirectorySlash Off,
# mod_dir would 301 "/edit" to "/edit/" because the directory exists, and the
# sibling-file rule below would 301 it straight back — an infinite loop.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 301s for URLs that moved during the page-type conversion -------------
  RewriteRule ^blog/?$                          /edit [R=301,L]
  RewriteRule ^blog\.html$                      /edit [R=301,L]
  RewriteRule ^collections/?$                   /brands [R=301,L]
  RewriteRule ^collections\.html$               /brands [R=301,L]
  RewriteRule ^atp-atelier-vs-flattered/?$      /edit/atp-atelier-vs-flattered [R=301,L]
  RewriteRule ^atp-atelier-vs-flattered\.html$  /edit/atp-atelier-vs-flattered [R=301,L]
  RewriteRule ^sitemap\.xml$                    /sitemap-index.xml [R=301,L]

  # --- /edit/ -> /edit  (silo index lives at edit.html beside the directory) -
  # Must precede the generic trailing-slash rule, which would skip it because
  # the directory genuinely exists.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # --- Generic: strip a trailing slash from non-directories ------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # --- A request for /path.html redirects to the canonical /path -------------
  # Guarded on THE_REQUEST (the literal request line) so the internal rewrite
  # below cannot re-trigger it and loop.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # --- Serve /path from /path.html, internally --------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Long-cache the fingerprinted bundles Astro emits; everything else revalidates.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png                "access plus 30 days"
  ExpiresByType image/svg+xml            "access plus 30 days"
  ExpiresByType text/css                 "access plus 7 days"
  ExpiresByType application/javascript   "access plus 7 days"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>
